# ── Supabase (client-exposed — safe to commit placeholders) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only — DO NOT expose to the client) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (server-only — DO NOT expose) ──
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ID_PRO=price_

# ── Stripe (client-exposed) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ── Data providers (server-only) ──
ODDS_API_KEY=

# ── Cron auth (server-only) — generate a random value, must match Vercel Cron config ──
CRON_SECRET=

# ── App URL (used for absolute links in emails/redirects/metadata) ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: rate limiting backing store ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: analytics ──
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=
